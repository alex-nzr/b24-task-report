{
  "name": "local/bitrix-task-report",
  "type": "project",
  "description": "Employee task time reports for a cloud Bitrix24 portal",
  "license": "proprietary",
  "require": {
    "php": ">=8.3 <8.4",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/yaml": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/form": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/rate-limiter": "7.4.*",
    "symfony/cache": "7.4.*",
    "doctrine/doctrine-bundle": "^2.18",
    "doctrine/doctrine-migrations-bundle": "^3.7",
    "doctrine/dbal": "^4.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/maker-bundle": "^1.68"
  },
  "autoload": {"psr-4": {"App\\": "src/", "DoctrineMigrations\\": "migrations/"}},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "config": {"sort-packages": true, "platform": {"php": "8.3.6"}},
  "scripts": {"test": "@php vendor/phpunit/phpunit/phpunit", "analyse": "@php vendor/phpstan/phpstan/phpstan analyse --memory-limit=512M"}
}

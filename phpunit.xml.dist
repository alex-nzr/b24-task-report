<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache" failOnWarning="true">
  <testsuites><testsuite name="Application"><directory>tests</directory></testsuite></testsuites>
  <php><env name="APP_ENV" value="test" force="true"/><env name="APP_DEBUG" value="0" force="true"/></php>
</phpunit>
